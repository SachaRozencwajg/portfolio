#!/usr/bin/env bash
# ============================================
# portfolioUP — met à jour et redéploie tout le portfolio en une commande
#
#   portfolioUP              récupère main, régénère les publications, déploie le site
#                            puis redéploie la Cloud Function des publications
#   portfolioUP --site-only      idem, sans redéployer la Cloud Function
#   portfolioUP --function-only  redéploie uniquement la Cloud Function
#   portfolioUP --install    installe l'alias « portfolioUP » dans ~/.zshrc (ou ~/.bashrc)
# ============================================

set -euo pipefail

SITE_URL="https://www.sacha-rozencwajg.fr"
PROJECT_ID="portfolio-sacha"
FUNCTION_ENTRY_POINT="check_publications"
BRANCH="main"

# --- Localiser le dépôt, même si le script est appelé via un lien ou un alias (compatible macOS)
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
    DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
    SOURCE="$(readlink "$SOURCE")"
    [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_PATH="$(cd -P "$(dirname "$SOURCE")" && pwd)/$(basename "$SOURCE")"
REPO_DIR="$(cd -P "$(dirname "$SOURCE")/.." && pwd)"

step() { printf '\n\033[1;34m▶ %s\033[0m\n' "$1"; }
ok()   { printf '\033[1;32m✔ %s\033[0m\n' "$1"; }
fail() { printf '\033[1;31m✖ %s\033[0m\n' "$1" >&2; exit 1; }

# --- Installation de l'alias
if [ "${1:-}" = "--install" ]; then
    case "${SHELL:-}" in
        */zsh) RC="$HOME/.zshrc" ;;
        *)     RC="$HOME/.bashrc" ;;
    esac
    chmod +x "$SCRIPT_PATH"
    # Guillemets imbriqués : le chemin peut contenir des espaces (ex. « Mon Drive »)
    LINE="alias portfolioUP=\"'$SCRIPT_PATH'\""
    if grep -qs "alias portfolioUP=" "$RC"; then
        { grep -v "alias portfolioUP=" "$RC" || true; } > "$RC.tmp"
        mv "$RC.tmp" "$RC"
    fi
    echo "$LINE" >> "$RC"
    ok "Alias ajouté dans $RC"
    echo "Ouvre un nouveau terminal (ou lance : source $RC), puis tape : portfolioUP"
    exit 0
fi

DEPLOY_SITE=true
DEPLOY_FUNCTION=true
case "${1:-}" in
    --site-only)     DEPLOY_FUNCTION=false ;;
    --function-only) DEPLOY_SITE=false ;;
    "") ;;
    *) fail "Option inconnue : $1 (options : --site-only, --function-only, --install)" ;;
esac

cd "$REPO_DIR"
echo "📁 Dépôt : $REPO_DIR"

# --- 1. Prérequis
step "Vérification des prérequis"
command -v git >/dev/null     || fail "git introuvable"
command -v python3 >/dev/null || fail "python3 introuvable"
command -v gcloud >/dev/null  || fail "gcloud introuvable (installe le Google Cloud SDK)"
[ -n "$(gcloud auth list --filter=status:ACTIVE --format='value(account)' 2>/dev/null)" ] \
    || fail "Aucun compte gcloud actif : lance « gcloud auth login »"
[ -z "$(git status --porcelain)" ] \
    || fail "Modifications locales non commitées : commit ou « git stash » avant de déployer"
ok "OK"

# --- 2. Récupérer la dernière version (y compris les mises à jour auto des publications)
step "Récupération de la dernière version de $BRANCH"
git fetch origin "$BRANCH"
git checkout "$BRANCH"
git pull --ff-only origin "$BRANCH"
ok "À jour : $(git log -1 --format='%h %s')"

# --- 3. Régénérer la liste des publications depuis .agent/publications.json
step "Régénération de la liste des publications"
python3 cloud-function/publications_html.py
if [ -n "$(git status --porcelain index.html)" ]; then
    git add index.html
    git commit -m "Régénère la liste des publications"
    git push origin "$BRANCH"
    ok "Liste mise à jour et poussée sur GitHub"
else
    ok "Déjà à jour"
fi

# --- 4. Déployer le site sur Cloud Run
if $DEPLOY_SITE; then
    step "Déploiement du site (Cloud Run)"
    bash ./deploy.sh
fi

# --- 5. Redéployer la Cloud Function (en conservant sa configuration actuelle)
if $DEPLOY_FUNCTION; then
    step "Redéploiement de la Cloud Function des publications"
    # Nom, génération et région lus depuis le JSON (le format texte de gcloud varie selon les versions)
    FUNCTION_INFO="$(gcloud functions list --project "$PROJECT_ID" --format=json 2>/dev/null | python3 -c '
import json, re, sys
entry = sys.argv[1]
for f in json.load(sys.stdin):
    ep = f.get("entryPoint") or f.get("buildConfig", {}).get("entryPoint")
    if ep != entry:
        continue
    name = f.get("name", "")
    region = ""
    m = re.search(r"/locations/([^/]+)/", name)
    if m:
        region = m.group(1)
    region = region or f.get("location") or f.get("region") or ""
    if not region:
        url = f.get("url") or f.get("serviceConfig", {}).get("uri") or ""
        m = re.match(r"https://([a-z]+-[a-z]+[0-9]+)-", url)
        region = m.group(1) if m else ""
    print(name.rsplit("/", 1)[-1], f.get("environment", "GEN_1"), region)
    break
' "$FUNCTION_ENTRY_POINT")"
    if [ -z "$FUNCTION_INFO" ]; then
        echo "⚠️  Aucune fonction « $FUNCTION_ENTRY_POINT » trouvée dans $PROJECT_ID : étape ignorée"
    else
        read -r FUNCTION_NAME FUNCTION_ENV FUNCTION_REGION <<< "$FUNCTION_INFO"
        # Région introuvable dans la liste : on la teste sur les régions probables
        if [ -z "${FUNCTION_REGION:-}" ]; then
            for candidate in europe-west1 europe-west9 europe-west3 us-central1; do
                if gcloud functions describe "$FUNCTION_NAME" --project "$PROJECT_ID" \
                    --region "$candidate" >/dev/null 2>&1; then
                    FUNCTION_REGION="$candidate"
                    break
                fi
            done
        fi
        [ -n "${FUNCTION_REGION:-}" ] || fail "Région de la fonction $FUNCTION_NAME introuvable"
        GEN_FLAG="--no-gen2"
        [ "$FUNCTION_ENV" = "GEN_2" ] && GEN_FLAG="--gen2"
        echo "Fonction : $FUNCTION_NAME ($FUNCTION_REGION, ${FUNCTION_ENV:-GEN_1})"
        # Mise à jour du code uniquement : runtime, déclencheur, variables et secrets sont conservés
        gcloud functions deploy "$FUNCTION_NAME" \
            --project "$PROJECT_ID" \
            --region "$FUNCTION_REGION" \
            "$GEN_FLAG" \
            --source cloud-function \
            --entry-point "$FUNCTION_ENTRY_POINT" \
            --quiet
        ok "Cloud Function redéployée"
    fi
fi

# --- 6. Vérification
step "Vérification du site en ligne"
HTTP_CODE="$(curl -s -o /dev/null -w '%{http_code}' "$SITE_URL" || true)"
if [ "$HTTP_CODE" = "200" ]; then
    ok "$SITE_URL répond (HTTP 200)"
else
    echo "⚠️  $SITE_URL répond HTTP $HTTP_CODE — vérifie dans la console Cloud Run"
fi

printf '\n\033[1;32m🚀 Portfolio à jour !\033[0m\n'
